{
  "id": "ui-aesthetics-design",
  "name": "ui-aesthetics-design",
  "title": "UI 美学设计",
  "description": "通用网页/组件 UI 美学设计审查与生成的可执行指南：配色对比、排版、间距、层级、控件、无障碍、反例与风格边界，来源可追溯。",
  "whenToUse": "需要生成或审查网页/组件/仪表盘/表单的视觉美感与可用性时；需要在配色、字体、间距、层级、控件、焦点态、动效上做可复核检查时。",
  "boundary": "不负责品牌/VI/Logo 设计；不绑定特定技术栈；数据密集界面与品牌强风格需叠加专项边界。",
  "notWhenToUse": "只做后端/纯逻辑/架构重构时；需要完整品牌视觉身份或完整设计系统定制时。",
  "scenario": "distillation",
  "scenarios": [
    "distillation",
    "research"
  ],
  "routing": "domain",
  "qualityCriteria": {
    "high": [
      "每条规则有 source_refs",
      "触发/动作/边界三件套齐全",
      "核心规则 ≥2 个独立来源或官方一手；单源明确降权",
      "至少 1 个反例或失效边界",
      "样例可复现：问题→命中规则→具体改进"
    ],
    "reject": [
      "无来源断言",
      "把单一风格偏好写成普适规则",
      "只给正向例子无边界",
      "内部蒸馏字段/产物名泄露到用户文档"
    ],
    "minIndependentSources": 2,
    "notes": "风格分支（圆角/无阴影/单色等）必须标注为风格分支并降权。"
  },
  "tags": [
    "UI",
