    "research"
  ],
  "routing": "domain",
  "qualityCriteria": {
    "high": [
      "含触发/动作/边界/反例四件套",
      "覆盖实验变量、假设检验、显著性/效应量、样本量与可复现性清单",
      "核心规则 ≥2 独立来源或官方一手"
    ],
    "reject": [
      "把 p<0.05 当作效应存在或证明因果",
      "跳过预注册/先验假设，事后编假设",
      "用事后功效代替事前样本量计算",
      "无来源且无边界地给统计结论"
    ],
    "minIndependentSources": 2
  },
