{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dsh-skill-vault skill manifest",
  "type": "object",
  "required": ["id", "description", "scenario"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string", "minLength": 1 },
    "whenToUse": { "type": "string" },
    "boundary": { "type": "string" },
    "notWhenToUse": { "type": "string" },
    "scenario": { "type": "string" },
    "scenarios": { "type": "array", "items": { "type": "string" } },
    "routing": { "enum": ["base", "core", "domain"] },
    "qualityCriteria": {
      "type": "object",
      "properties": {
        "high": { "type": "array", "items": { "type": "string" } },
        "reject": { "type": "array", "items": { "type": "string" } },
        "minIndependentSources": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
    "experts": { "type": "array", "items": { "type": "string" } },
    "sourceRefs": { "type": "array", "items": { "type": "string" } },
    "activation": { "enum": ["catalog", "always-on", "internal"] },
    "hidden": { "type": "boolean" },
    "version": { "type": "string" },
    "license": { "type": "string" }
  },
  "additionalProperties": true
}
