{
  "name": "@dsh-external/dsh-skill-vault",
  "version": "0.0.1",
  "description": "DSH 技能保险库：统筹蒸馏 skill、按场景开关、agent 工具 + Web 可视化面板",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "vault",
    "scripts",
    "README.md",
    "DESIGN.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "validate:vault": "node scripts/validate-vault.mjs",
    "validate:tags": "node scripts/validate-tags.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dargonburn337845818/skill-group.git"
  },
  "homepage": "https://github.com/dargonburn337845818/skill-group",
  "bugs": {
    "url": "https://github.com/dargonburn337845818/skill-group/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
